{
  "manifest_version": 3,
  "name": "Shopify Product Helper",
  "version": "1.0.0",
  "description": "在 Shopify 商品编辑页面提供辅助功能",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://admin.shopify.com/store/*/products/*",
        "https://*.myshopify.com/admin/products/*"
      ],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
