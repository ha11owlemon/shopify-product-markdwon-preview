{
  "manifest_version": 3,
  "name": "工具箱",
  "version": "1.2.0",
  "description": "在 Shopify 商品编辑页面提供运营工具",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://admin.shopify.com/store/*",
        "https://*.myshopify.com/admin/*"
      ],
      "js": [
        "scripts/integrations/shopify/codemirror-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://admin.shopify.com/store/*",
        "https://*.myshopify.com/admin/*"
      ],
      "js": [
        "libs/markdown-it.min.js",
        "libs/markdown-it-container.js",
        "scripts/core/registry.js",
        "scripts/core/runtime.js",
        "scripts/core/floating-toolbox.js",
        "scripts/integrations/shopify/codemirror-bridge.js",
        "scripts/integrations/shopify/product-editor.js",
        "scripts/features/markdown/renderer.js",
        "scripts/features/markdown/status-indicator.js",
        "scripts/features/markdown/panel.js",
        "scripts/features/markdown/tool.js",
        "scripts/features/pricing-calculator/formula.js",
        "scripts/features/pricing-calculator/templates.js",
        "scripts/features/pricing-calculator/panel.js",
        "scripts/features/pricing-calculator/tool.js",
        "scripts/bootstrap.js"
      ],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
